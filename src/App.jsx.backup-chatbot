function SimplePage({kind}){ const data={about:{label:"ABOUT JUMAA",title:<>Property discovery,<br/><em>made simpler.</em></>,text:"JUMAA is building a modern way for people to discover homes and for property owners to connect with the people looking for them."},"how-it-works":{label:"HOW IT WORKS",title:<>Find. Connect.<br/><em>Move forward.</em></>,text:"Search properties, explore real listing information and connect directly with owners. Property owners can list and promote their homes through JUMAA."}}[kind]; return <Layout><main><section className="simple-hero"><span className="section-label">{data.label}</span><h1>{data.title}</h1><p>{data.text}</p></section><section className="simple-grid"><div><MapPin/><h3>Local first</h3><p>Search by counties, areas and neighbourhoods that make sense to you.</p></div><div><ShieldCheck/><h3>Trust matters</h3><p>Clear information and verification are part of the JUMAA experience.</p></div><div><Smartphone/><h3>Built for mobile</h3><p>Use the web or take your search with you through the JUMAA app.</p></div></section></main></Layout> }

function FAQ(){const qs=["Is JUMAA free for tenants?","Who pays the JUMAA subscription?","How does property Boost work?","Can I list more than one property?","How do I contact a property owner?","How can I get my property verified?"]; const [open,setOpen]=useState(0); const ans=["Yes. Tenants can browse and discover homes without paying the property owner's JUMAA subscription.","The monthly JUMAA service subscription is paid by the property owner or authorized property manager. It is separate from rent.","Boost gives a property priority visibility for the selected period. When the period ends, the property returns to normal ranking.","JUMAA is designed to support property owners and managers with multiple properties and units.","Open a property listing and use the available contact or WhatsApp action.","Verification is handled through JUMAA's owner/property review process as the platform grows."]; return <Layout><main><section className="simple-hero faq-hero"><span className="section-label">JUMAA FAQ</span><h1>Questions?<br/><em>We've got answers.</em></h1><p>Everything you need to know about finding homes and using JUMAA.</p></section><section className="faq-list">{qs.map((q,i)=><div className={open===i?"faq-item open":"faq-item"} key={q}><button onClick={()=>setOpen(open===i?-1:i)}><span>{q}</span>{open===i?<ChevronDown/>:<ChevronRight/>}</button>{open===i&&<p>{ans[i]}</p>}</div>)}</section></main></Layout>}

function Contact(){const [sent,setSent]=useState(false); return <Layout><main><section className="contact-page"><div className="contact-intro"><span className="section-label">CONTACT JUMAA</span><h1>Let's talk<br/><em>about JUMAA.</em></h1><p>Need help, want to list a property or discuss a partnership? Send us a message.</p><div className="contact-list"><a href={WHATSAPP} target="_blank" rel="noreferrer"><FaWhatsapp/><span><small>WhatsApp</small><b>Chat with us</b></span></a><a href={`tel:+254${PHONE.slice(1)}`}><Phone/><span><small>Phone</small><b>{PHONE}</b></span></a><a href={`mailto:${EMAIL}`}><Mail/><span><small>Email</small><b>{EMAIL}</b></span></a></div></div><form className="contact-form" onSubmit={e=>{e.preventDefault();setSent(true)}}><label>Name<input required placeholder="Your name"/></label><label>Email<input type="email" required placeholder="you@example.com"/></label><label>What can we help with?<select><option>Finding a home</option><option>Listing a property</option><option>Boosting a property</option><option>Partnership</option><option>Support</option></select></label><label>Message<textarea required rows="6" placeholder="Tell us how we can help..."/></label><button className="primary-button">{sent?"Message ready — contact us on WhatsApp":"Send Message"}<ArrowRight size={18}/></button>{sent&&<p className="form-note">For the fastest response, use the WhatsApp button above to send your message directly.</p>}</form></section></main></Layout>}

function BillingPage(){const plans=[["1–10 units","KSh 1,000 / month"],["11–20 units","KSh 2,000 / month"],["21–30 units","KSh 3,000 / month"],["31–40 units","KSh 4,000 / month"],["41–50 units","KSh 5,000 / month"],["51–60 units","KSh 6,000 / month"],["61–70 units","KSh 7,000 / month"],["71–80 units","KSh 8,000 / month"],["81–90 units","KSh 9,000 / month"],["91–100 units","KSh 10,000 / month"],["101+ units","Custom plan"]];return <Layout><main><section className="billing-hero"><span className="section-label">JUMAA BILLING</span><h1>Simple pricing.<br/><em>Built for property owners.</em></h1><p>Transparent monthly service pricing based on the number of units in a property.</p></section><section className="billing-wrap"><div className="billing-table"><div className="billing-table-head"><span>PROPERTY SIZE</span><span>MONTHLY JUMAA SERVICE</span></div>{plans.map(x=><div className="billing-table-row" key={x[0]}><span>{x[0]}</span><strong>{x[1]}</strong></div>)}</div><div className="billing-owner-message"><ShieldCheck size={22}/><div><strong>Tenants do not pay the JUMAA subscription.</strong><p>The service fee is paid by the property owner or authorized property manager. It is separate from rent, deposits, utilities and other property charges.</p><div className="billing-free"><CheckCircle2 size={18}/><span><b>First month FREE.</b> The applicable subscription starts from month two.</span></div><a href={WHATSAPP} target="_blank" rel="noreferrer" className="primary-button">Talk to JUMAA <ArrowRight size={17}/></a></div></div></section></main></Layout>}

export default function App(){const path=window.location.pathname.replace(/\/$/,"")||"/"; if(path==="/billing")return <BillingPage/>; if(path==="/properties")return <PropertiesPage/>; if(path.startsWith("/property/"))return <PropertyPage id={path.split("/")[2]}/>; if(path==="/owners")return <OwnersPage/>; if(path==="/about")return <SimplePage kind="about"/>; if(path==="/how-it-works")return <SimplePage kind="how-it-works"/>; if(path==="/faq")return <FAQ/>; if(path==="/contact")return <Contact/>; return <HomePage/>;}
