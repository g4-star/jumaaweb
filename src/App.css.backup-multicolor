/* =========================================================
   JUMAA ASSISTANT
   ========================================================= */

.jumaa-chat-float {
  position: fixed;
  right: 22px;
  bottom: 22px;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.14);
  background: var(--green);
  color: #06251a;
  display: grid;
  place-items: center;
  font-size: 25px;
  box-shadow: 0 15px 40px rgba(0,0,0,.35);
  z-index: 100;
  transition: .25s;
}

.jumaa-chat-float:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 20px 45px rgba(41,211,145,.25);
}

.jumaa-chat-float.active {
  background: #10201a;
  color: #fff;
  border-color: rgba(41,211,145,.35);
}

.jumaa-chatbot {
  position: fixed;
  right: 22px;
  bottom: 92px;
  width: 370px;
  max-width: calc(100vw - 30px);
  height: 590px;
  max-height: calc(100vh - 120px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #08140f;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 22px;
  box-shadow: 0 30px 90px rgba(0,0,0,.5);
  z-index: 99;
  animation: jumaaChatOpen .22s ease-out;
}

@keyframes jumaaChatOpen {
  from { opacity: 0; transform: translateY(15px) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.jumaa-chat-header {
  min-height: 70px;
  padding: 13px 15px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  background: #0b1914;
}

.jumaa-chat-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.jumaa-bot-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(41,211,145,.12);
  font-size: 21px;
}

.jumaa-chat-title strong,
.jumaa-chat-title span {
  display: block;
}

.jumaa-chat-title strong {
  font: 800 13px Manrope;
}

.jumaa-chat-title span {
  color: var(--muted);
  font-size: 10px;
  margin-top: 3px;
}

.jumaa-chat-title span i {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 5px;
  border-radius: 50%;
  background: var(--green);
}

.jumaa-chat-header > button {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #9aa9a2;
}

.jumaa-chat-header > button:hover {
  background: rgba(255,255,255,.06);
  color: #fff;
}

.jumaa-chat-body {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  scrollbar-width: thin;
}

.jumaa-message {
  width: fit-content;
  max-width: 88%;
  padding: 11px 13px;
  margin-bottom: 9px;
  border-radius: 14px;
  font-size: 12px;
  line-height: 1.55;
}

.jumaa-message.bot {
  background: #10201a;
  color: #dce7e2;
  border-bottom-left-radius: 5px;
}

.jumaa-message.user {
  margin-left: auto;
  background: var(--green);
  color: #06251a;
  font-weight: 700;
  border-bottom-right-radius: 5px;
}

.jumaa-quick-actions,
.jumaa-quiz-picker {
  display: grid;
  gap: 7px;
  margin-top: 13px;
}

.jumaa-quick-actions a,
.jumaa-quick-actions button,
.jumaa-quiz-picker button {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #0d1d17;
  color: #dce7e2;
  text-align: left;
  font-size: 11px;
  text-decoration: none;
  transition: .2s;
}

.jumaa-quick-actions a:hover,
.jumaa-quick-actions button:hover,
.jumaa-quiz-picker button:hover {
  border-color: rgba(41,211,145,.35);
  background: rgba(41,211,145,.07);
  color: #fff;
}

.jumaa-quiz-picker strong {
  font: 800 12px Manrope;
  margin-bottom: 2px;
}

.jumaa-quiz {
  margin-top: 12px;
  padding: 15px;
  border: 1px solid rgba(41,211,145,.18);
  border-radius: 15px;
  background: rgba(41,211,145,.035);
}

.quiz-progress {
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.jumaa-quiz h4 {
  margin: 10px 0 14px;
  font-size: 14px;
  line-height: 1.45;
}

.quiz-options {
  display: grid;
  gap: 7px;
}

.quiz-options button {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0b1914;
  color: #dce7e2;
  text-align: left;
  font-size: 11px;
  line-height: 1.4;
}

.quiz-options button > span {
  min-width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: rgba(255,255,255,.06);
  color: var(--green);
  font-weight: 800;
}

.quiz-options button:not(:disabled):hover {
  border-color: rgba(41,211,145,.4);
}

.quiz-options button.correct {
  background: rgba(41,211,145,.1);
  border-color: rgba(41,211,145,.55);
}

.quiz-options button.correct > span {
  background: var(--green);
  color: #06251a;
}

.quiz-options button.wrong {
  background: rgba(255,80,100,.08);
  border-color: rgba(255,80,100,.4);
}

.quiz-options button.wrong > span {
  color: #ff7184;
}

.quiz-result {
  margin-top: 12px;
  padding: 12px;
  border-radius: 10px;
  background: rgba(255,255,255,.035);
}

.quiz-result strong {
  font-size: 12px;
}

.quiz-result p {
  color: var(--muted);
  font-size: 10px;
  line-height: 1.6;
  margin: 5px 0 10px;
}

.quiz-result button {
  width: 100%;
  padding: 9px;
  border: 0;
  border-radius: 9px;
  background: var(--green);
  color: #06251a;
  font-size: 11px;
  font-weight: 800;
}

.quiz-score {
  margin-top: 11px;
  color: var(--muted);
  font-size: 10px;
  text-align: right;
}

.jumaa-reset-chat {
  width: 100%;
  margin-top: 12px;
  padding: 9px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  font-size: 10px;
}

.jumaa-reset-chat:hover {
  color: var(--green);
  border-color: rgba(41,211,145,.35);
}

.jumaa-chat-input {
  display: flex;
  gap: 7px;
  padding: 11px;
  border-top: 1px solid var(--line);
  background: #0b1914;
}

.jumaa-chat-input input {
  min-width: 0;
  flex: 1;
  padding: 11px 12px;
  border: 1px solid var(--line);
  border-radius: 11px;
  outline: none;
  background: #07110e;
  color: #fff;
  font-size: 11px;
}

.jumaa-chat-input input:focus {
  border-color: rgba(41,211,145,.45);
}

.jumaa-chat-input input::placeholder {
  color: #68766f;
}

.jumaa-chat-input > button {
  width: 40px;
  border: 0;
  border-radius: 10px;
  background: var(--green);
  color: #06251a;
  display: grid;
  place-items: center;
}

@media(max-width:620px) {
  .jumaa-chatbot {
    right: 10px;
    bottom: 80px;
    width: calc(100vw - 20px);
    height: min(590px, calc(100vh - 105px));
    border-radius: 18px;
  }

  .jumaa-chat-float {
    right: 15px;
    bottom: 15px;
  }
}

