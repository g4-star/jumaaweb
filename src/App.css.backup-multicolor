  border-radius:20px;
  background:linear-gradient(145deg,rgba(16,32,26,.96),rgba(10,23,18,.96));
}

.market-filter-panel.open{
  display:block;
}

.filter-panel-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  margin-bottom:22px;
}

.filter-panel-head h3{
  margin:5px 0 0;
  font-size:21px;
}

.clear-filters{
  border:0;
  background:transparent;
  color:var(--green);
  cursor:pointer;
  font-weight:700;
}

.advanced-filters{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
}

.advanced-filters label{
  display:flex;
  flex-direction:column;
  gap:8px;
  color:var(--muted);
  font-size:12px;
  font-weight:700;
}

.advanced-filters select,
.advanced-filters input{
  width:100%;
  min-height:44px;
  box-sizing:border-box;
  padding:0 12px;
  border:1px solid var(--line);
  border-radius:11px;
  outline:0;
  background:#091610;
  color:var(--white);
}

.advanced-filters select:focus,
.advanced-filters input:focus{
  border-color:rgba(41,211,145,.5);
}

.verified-filter{
  grid-column:span 2;
}

.verified-toggle{
  min-height:44px;
  display:flex;
  align-items:center;
  gap:8px;
  padding:0 13px;
  border:1px solid var(--line);
  border-radius:11px;
  background:#091610;
  color:var(--muted);
  cursor:pointer;
  text-align:left;
}

.verified-toggle.active{
  border-color:rgba(41,211,145,.55);
  background:rgba(41,211,145,.09);
  color:var(--green);
}

.compare-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  margin:0 0 22px;
  padding:13px 16px;
  border:1px solid rgba(41,211,145,.25);
  border-radius:15px;
  background:rgba(41,211,145,.06);
}

.compare-bar-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.compare-bar-actions>button:not(.primary-button){
  border:0;
  background:transparent;
  color:var(--muted);
  cursor:pointer;
}

.compare-bar .primary-button{
  min-height:40px;
  padding:0 15px;
  border:0;
  cursor:pointer;
}

.market-property-wrap{
  min-width:0;
  position:relative;
}

.market-property-wrap .property-card{
  height:100%;
}

.compare-select{
  position:absolute;
  left:12px;
  bottom:12px;
  z-index:5;
  display:flex;
  align-items:center;
  gap:6px;
  min-height:34px;
  padding:0 10px;
  border:1px solid rgba(255,255,255,.16);
  border-radius:9px;
  background:rgba(5,15,11,.86);
  color:#fff;
  backdrop-filter:blur(8px);
  cursor:pointer;
  font-size:11px;
  font-weight:700;
}

.compare-select span{
  width:17px;
  height:17px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:rgba(255,255,255,.1);
}

.compare-select:hover{
  border-color:rgba(41,211,145,.55);
}

.compare-select.selected{
  border-color:var(--green);
  background:rgba(41,211,145,.14);
  color:var(--green);
}

.compare-select:disabled{
  opacity:.45;
  cursor:not-allowed;
}

.marketplace-bottom-note{
  display:flex;
  align-items:flex-start;
  justify-content:center;
  gap:10px;
  max-width:650px;
  margin:42px auto 0;
  padding:18px;
  border-top:1px solid var(--line);
  color:var(--muted);
  text-align:left;
}

.marketplace-bottom-note svg{
  flex:none;
  color:var(--green);
  margin-top:2px;
}

.marketplace-bottom-note div{
  display:flex;
  flex-direction:column;
  gap:4px;
}

.marketplace-bottom-note strong{
  color:var(--white);
}

.marketplace-empty{
  padding:80px 20px;
}

.empty-icon{
  width:72px;
  height:72px;
  display:grid;
  place-items:center;
  margin:0 auto 20px;
  border-radius:22px;
  background:rgba(41,211,145,.08);
  color:var(--green);
}

.marketplace-empty .primary-button{
  margin-top:20px;
  border:0;
  cursor:pointer;
}

/* Compare modal */

.compare-overlay{
  position:fixed;
  inset:0;
  z-index:100;
  display:grid;
  place-items:center;
  padding:24px;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(12px);
}

.compare-modal{
  width:min(1120px,100%);
  max-height:90vh;
  overflow:auto;
  border:1px solid rgba(255,255,255,.12);
  border-radius:24px;
  background:#08140f;
  box-shadow:0 35px 100px rgba(0,0,0,.5);
}

.compare-modal-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:20px;
  padding:26px 28px;
  border-bottom:1px solid var(--line);
}

.compare-modal-head h2{
  margin:5px 0 0;
}

.compare-modal-head>button{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  border:1px solid var(--line);
  border-radius:11px;
  background:rgba(255,255,255,.04);
  color:var(--white);
  cursor:pointer;
}

.compare-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
  padding:24px 28px;
}

.compare-card{
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:18px;
  background:rgba(255,255,255,.025);
}

.compare-image{
  position:relative;
  height:180px;
}

.compare-image img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
}

.compare-image>span{
  position:absolute;
  left:12px;
  top:12px;
  display:flex;
  align-items:center;
  gap:5px;
  padding:6px 9px;
  border-radius:999px;
  background:rgba(5,20,14,.85);
  color:var(--green);
  font-size:11px;
  font-weight:800;
}

.compare-content{
  padding:18px;
}

.compare-content h3{
  margin:0 0 7px;
}

.compare-content>p{
  display:flex;
  align-items:center;
  gap:5px;
  margin:0;
  color:var(--muted);
  font-size:12px;
}

.compare-price{
  display:flex;
  align-items:baseline;
  gap:5px;
  margin:18px 0;
}

.compare-price small{
  color:var(--muted);
}

.compare-price strong{
  color:var(--green);
  font-size:21px;
}

.compare-price span{
  color:var(--muted);
  font-size:11px;
}

.compare-details{
  display:grid;
  gap:9px;
  margin-bottom:18px;
}

.compare-details div{
  display:flex;
  align-items:center;
  gap:8px;
  color:var(--muted);
  font-size:12px;
}

.compare-details svg{
  color:var(--green);
}

.compare-content .primary-button{
  width:100%;
  min-height:42px;
  justify-content:center;
  box-sizing:border-box;
}

.compare-modal-foot{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding:18px 28px;
  border-top:1px solid var(--line);
  color:var(--muted);
  font-size:12px;
}

.compare-modal-foot button{
  border:0;
  background:transparent;
  color:var(--green);
  cursor:pointer;
  font-weight:700;
}

/* Mobile */

@media(max-width:900px){
  .advanced-filters{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .verified-filter{
    grid-column:span 2;
  }

  .compare-grid{
    grid-template-columns:1fr;
  }

  .compare-image{
    height:210px;
  }
}

@media(max-width:640px){
  .market-search{
    min-height:56px;
    padding:0 15px;
    border-radius:15px;
  }

  .market-search input{
    font-size:14px;
  }

  .market-quick-stats{
    justify-content:flex-start;
  }

  .market-toolbar{
    align-items:flex-start;
    flex-direction:column;
  }

  .market-toolbar-actions{
    width:100%;
  }

  .sort-select{
    flex:1;
  }

  .filter-toggle{
    flex:1;
    justify-content:center;
  }

  .advanced-filters{
    grid-template-columns:1fr;
  }

  .verified-filter{
    grid-column:auto;
  }

  .compare-bar{
    align-items:flex-start;
    flex-direction:column;
  }

  .compare-bar-actions{
    width:100%;
  }

  .compare-bar-actions .primary-button{
    flex:1;
    justify-content:center;
  }

  .compare-overlay{
    padding:10px;
  }

  .compare-modal{
    max-height:94vh;
    border-radius:18px;
  }

  .compare-modal-head,
  .compare-modal-foot{
    padding:20px;
  }

  .compare-grid{
    padding:16px 20px;
  }

  .compare-modal-foot{
    align-items:flex-start;
    flex-direction:column;
  }
}


/* =========================================================
   JUMAA SAFETY CENTER / REPORT A SCAM
   ========================================================= */

.scam-hero{
  max-width:1200px;
  margin:0 auto;
  padding:110px 24px 70px;
  display:grid;
  grid-template-columns:1.5fr .5fr;
  gap:50px;
  align-items:center;
}

.scam-hero-content h1{
  margin:16px 0;
  font-size:clamp(42px,6vw,72px);
  line-height:1;
}

.scam-hero-content h1 em{
  color:var(--green);
  font-style:normal;
}

.scam-hero-content>p{
  max-width:680px;
  color:var(--muted);
  font-size:17px;
  line-height:1.7;
}

.scam-warning{
  max-width:650px;
  margin-top:30px;
  display:flex;
  gap:14px;
  padding:18px;
  border:1px solid rgba(255,184,77,.25);
  border-radius:16px;
  background:rgba(255,184,77,.06);
}

.scam-warning>svg{
  flex:none;
  color:#ffbd5a;
}

.scam-warning div{
  display:flex;
  flex-direction:column;
  gap:5px;
}

.scam-warning strong{
  color:#ffd28b;
}

.scam-warning span{
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}

.scam-hero-icon{
  display:grid;
  place-items:center;
  position:relative;
}

.scam-hero-icon>div{
  width:190px;
  height:190px;
  display:grid;
  place-items:center;
  border:1px solid rgba(41,211,145,.28);
  border-radius:55px;
  background:radial-gradient(circle,rgba(41,211,145,.15),rgba(41,211,145,.02) 65%);
  color:var(--green);
  box-shadow:0 30px 80px rgba(0,0,0,.3);
}

.scam-hero-icon>span{
  margin-top:-18px;
  padding:7px 13px;
  border:1px solid rgba(41,211,145,.25);
  border-radius:999px;
  background:#08140f;
  color:var(--green);
  font-size:10px;
  font-weight:900;
  letter-spacing:1.5px;
  text-align:center;
}

.scam-content{
  width:min(1200px,calc(100% - 48px));
  margin:0 auto;
  padding:30px 0 90px;
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:70px;
}

.scam-info h2{
  margin:10px 0 30px;
  font-size:34px;
}

.scam-sign{
  display:grid;
  grid-template-columns:40px 1fr;
  gap:16px;
  padding:20px 0;
  border-bottom:1px solid var(--line);
}

.scam-sign>span{
  width:34px;
  height:34px;
  display:grid;
  place-items:center;
  border-radius:10px;
  background:rgba(41,211,145,.08);
  color:var(--green);
  font-size:11px;
  font-weight:800;
}

.scam-sign h3{
  margin:0 0 7px;
  font-size:16px;
}

.scam-sign p{
  margin:0;
  color:var(--muted);
  font-size:13px;
  line-height:1.65;
}

.scam-help-box{
  display:flex;
  gap:13px;
  margin-top:24px;
  padding:17px;
  border:1px solid rgba(41,211,145,.2);
  border-radius:15px;
  background:rgba(41,211,145,.05);
}

.scam-help-box>svg{
  flex:none;
  color:var(--green);
}

.scam-help-box strong{
  color:var(--white);
}

.scam-help-box p{
  margin:5px 0 0;
  color:var(--muted);
  font-size:12px;
  line-height:1.6;
}

.scam-form-wrap{
  min-width:0;
}

.scam-form{
  padding:30px;
  border:1px solid var(--line);
  border-radius:24px;
  background:linear-gradient(145deg,rgba(16,32,26,.95),rgba(8,20,15,.98));
  box-shadow:0 30px 80px rgba(0,0,0,.2);
}

.form-heading{
  margin-bottom:26px;
}

.form-heading h2{
  margin:7px 0;
  font-size:30px;
}

.form-heading p{
  margin:0;
  color:var(--muted);
}

.scam-form label{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:17px;
  color:var(--muted);
  font-size:12px;
  font-weight:700;
}

.scam-form input,
.scam-form select,
.scam-form textarea{
  width:100%;
  box-sizing:border-box;
  border:1px solid var(--line);
  border-radius:11px;
  outline:0;
  background:#07120d;
  color:var(--white);
  padding:13px;
  font:inherit;
  resize:vertical;
}

.scam-form input,
.scam-form select{
  min-height:45px;
}

.scam-form input:focus,
.scam-form select:focus,
.scam-form textarea:focus{
  border-color:rgba(41,211,145,.5);
}

.scam-form-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.scam-form-security{
  display:flex;
  align-items:flex-start;
  gap:9px;
  margin:8px 0 20px;
  padding:12px;
  border-radius:11px;
  background:rgba(255,255,255,.03);
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
}

.scam-form-security svg{
  flex:none;
  color:var(--green);
}

.scam-submit{
  width:100%;
  justify-content:center;
  border:0;
  cursor:pointer;
}

.scam-success{
  min-height:500px;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  padding:45px;
  border:1px solid rgba(41,211,145,.25);
  border-radius:24px;
  background:linear-gradient(145deg,rgba(16,32,26,.95),rgba(8,20,15,.98));
}

.success-icon{
  width:70px;
  height:70px;
  display:grid;
  place-items:center;
  margin-bottom:24px;
  border-radius:22px;
  background:rgba(41,211,145,.1);
  color:var(--green);
}

.scam-success h2{
  margin:8px 0 12px;
  font-size:32px;
}

.scam-success>p{
  max-width:570px;
  color:var(--muted);
  line-height:1.7;
}

.report-reference{
  width:100%;
  max-width:400px;
  display:flex;
  flex-direction:column;
  gap:6px;
  margin:20px 0;
  padding:15px;
  border:1px dashed rgba(41,211,145,.3);
  border-radius:12px;
  background:rgba(41,211,145,.04);
}

.report-reference small{
  color:var(--muted);
  font-size:9px;
  letter-spacing:1.3px;
}

.report-reference strong{
  color:var(--green);
  letter-spacing:1px;
}

.success-actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:10px;
}

.success-actions .secondary-button{
  cursor:pointer;
}

.scam-footer{
  width:min(1000px,calc(100% - 48px));
  margin:0 auto 80px;
  display:flex;
  gap:14px;
  padding:22px;
  border:1px solid var(--line);
  border-radius:18px;
  background:rgba(255,255,255,.025);
}

.scam-footer>svg{
  flex:none;
  color:var(--green);
}

.scam-footer strong{
  color:var(--white);
}

.scam-footer p{
  margin:6px 0 0;
  color:var(--muted);
  font-size:12px;
  line-height:1.65;
}

@media(max-width:800px){
  .scam-hero{
    grid-template-columns:1fr;
    padding-top:70px;
  }

  .scam-hero-icon{
    display:none;
  }

  .scam-content{
    grid-template-columns:1fr;
    gap:40px;
  }
}

@media(max-width:600px){
  .scam-content{
    width:calc(100% - 30px);
  }

  .scam-form{
    padding:20px;
    border-radius:18px;
  }

  .scam-form-row{
    grid-template-columns:1fr;
    gap:0;
  }

  .scam-success{
    min-height:auto;
    padding:25px;
  }

  .scam-footer{
    width:calc(100% - 30px);
  }

  .success-actions{
    width:100%;
    flex-direction:column;
  }

  .success-actions>*{
    width:100%;
    justify-content:center;
    box-sizing:border-box;
  }
}


/* Report a Scam top navigation */
.nav-links .nav-scam {
  color: #ff7b7b;
  font-weight: 700;
}

.nav-links .nav-scam:hover {
  color: #ff4d4d;
}

@media (max-width: 900px) {
  .nav-links .nav-scam {
    color: #ff7b7b;
  }
}


/* =========================================================
   WELCOME TO KENYA — MULTICOLOR CAMPAIGN
   ========================================================= */

.welcome-kenya-section {
  position: relative;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  min-height: 590px;
  overflow: hidden;
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 91, 91, .18), transparent 28%),
    radial-gradient(circle at 65% 85%, rgba(109, 73, 255, .16), transparent 30%),
    #080b12;
  border-top: 1px solid rgba(255,255,255,.08);
  border-bottom: 1px solid rgba(255,255,255,.08);
}

/* Decorative color glow */
.welcome-kenya-section::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  right: -180px;
  top: -180px;
  border-radius: 50%;
  background: rgba(255, 174, 0, .18);
  filter: blur(80px);
  pointer-events: none;
}

.welcome-kenya-section::after {
  content: "";
  position: absolute;
  width: 320px;
  height: 320px;
  left: 38%;
  bottom: -180px;
  border-radius: 50%;
  background: rgba(91, 73, 255, .18);
  filter: blur(90px);
  pointer-events: none;
}

/* IMAGE */

.welcome-kenya-image {
  position: relative;
  min-height: 590px;
  overflow: hidden;
}

.welcome-kenya-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transform: scale(1.03);
  filter: saturate(1.12) contrast(1.05);
  transition: transform 1s ease;
}

.welcome-kenya-section:hover .welcome-kenya-image img {
  transform: scale(1.07);
}

.welcome-kenya-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(3, 8, 18, .05) 0%,
      rgba(3, 8, 18, .12) 35%,
      rgba(3, 8, 18, .86) 100%
    ),
    linear-gradient(
      180deg,
      rgba(255, 112, 48, .10),
      transparent 45%,
      rgba(6, 10, 25, .60)
    );
}

/* LOCATION BADGE */

.welcome-location {
  position: absolute;
  left: 32px;
  bottom: 30px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 11px 17px;
  border: 1px solid rgba(255,255,255,.20);
  border-radius: 999px;
  background: rgba(8, 11, 18, .58);
  backdrop-filter: blur(15px);
  color: #fff;
  font-size: .86rem;
  font-weight: 800;
  box-shadow: 0 10px 35px rgba(0,0,0,.28);
}

.welcome-location svg {
  color: #ffb000;
}

/* CONTENT */

.welcome-kenya-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 70px 8vw 70px 60px;

  background:
    radial-gradient(
      circle at 80% 15%,
      rgba(255, 91, 91, .12),
      transparent 30%
    ),
    radial-gradient(
      circle at 30% 90%,
      rgba(69, 113, 255, .12),
      transparent 32%
    ),
    rgba(8, 11, 18, .94);
}

/* COLORFUL EYEBROW */

.welcome-kenya-content .section-label {
  color: #ffb000;
  letter-spacing: .18em;
}

.welcome-kenya-content .section-label::before {
  background: linear-gradient(
    90deg,
    #ffb000,
    #ff5c5c,
    #6d49ff
  );
}

/* GLOBE */

.welcome-globe {
  margin-top: 22px;
  font-size: 2.7rem;
  line-height: 1;
  filter: drop-shadow(0 5px 18px rgba(255,174,0,.25));
}

/* HEADING */

.welcome-kenya-content h2 {
  margin: 16px 0 8px;
  font-size: clamp(2.7rem, 5vw, 5rem);
  line-height: .95;
  letter-spacing: -3px;
  color: #fff;
}

/* Gradient text on "Kenya?" */
.welcome-kenya-content h2 {
  background: linear-gradient(
    90deg,
    #ffffff 0%,
    #ffd166 38%,
    #ff7b54 68%,
    #a78bfa 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* SUBHEADING */

.welcome-kenya-content h3 {
  max-width: 620px;
  margin: 0;
  color: rgba(255,255,255,.91);
  font-size: clamp(1.2rem, 2vw, 1.7rem);
  line-height: 1.4;
  font-weight: 500;
}

/* JUMAA HAS GOT YOU */

.welcome-kenya-content > p {
  margin: 18px 0 0;
  color: #ffb86b;
  font-size: 1.35rem;
}

.welcome-kenya-content > p strong {
  color: #68e99d;
}

/* DESCRIPTION */

.welcome-description {
  max-width: 560px;
  color: rgba(255,255,255,.64) !important;
  font-size: 1rem !important;
  line-height: 1.85;
}

/* BUTTONS */

.welcome-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.welcome-actions .primary-button {
  background: linear-gradient(
    135deg,
    #ff9f1c,
    #ff5c5c
  );
  border: none;
  box-shadow:
    0 10px 30px rgba(255,92,92,.22);
}

.welcome-actions .primary-button:hover {
  transform: translateY(-3px);
  box-shadow:
    0 15px 38px rgba(255,92,92,.32);
}

.welcome-actions .secondary-button {
  border-color: rgba(167,139,250,.45);
  background: rgba(109,73,255,.10);
  color: #d8ccff;
}

.welcome-actions .secondary-button:hover {
  background: rgba(109,73,255,.20);
  border-color: #a78bfa;
  color: #fff;
}

/* FEATURE POINTS */

.welcome-points {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
  color: rgba(255,255,255,.67);
  font-size: .82rem;
}

.welcome-points span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.welcome-points span:nth-child(1) svg {
  color: #ffb000;
}

.welcome-points span:nth-child(2) svg {
  color: #55aaff;
}

.welcome-points span:nth-child(3) svg {
  color: #68e99d;
}

/* RESPONSIVE */

@media (max-width: 900px) {
  .welcome-kenya-section {
    grid-template-columns: 1fr;
  }

  .welcome-kenya-image {
    min-height: 400px;
    max-height: 450px;
  }

  .welcome-kenya-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(3,8,18,.02),
        rgba(3,8,18,.68)
      );
  }

  .welcome-kenya-content {
    padding: 55px 28px 60px;
  }
}

@media (max-width: 600px) {
  .welcome-kenya-image {
    min-height: 310px;
  }

  .welcome-location {
    left: 20px;
    bottom: 20px;
  }

  .welcome-kenya-content {
    padding: 45px 20px 50px;
  }

  .welcome-globe {
    font-size: 2.2rem;
  }

  .welcome-kenya-content h2 {
    font-size: 3rem;
    letter-spacing: -2px;
  }

  .welcome-kenya-content h3 {
    font-size: 1.15rem;
  }

  .welcome-actions {
    flex-direction: column;
  }

  .welcome-actions a {
    width: 100%;
    justify-content: center;
  }

  .welcome-points {
    flex-direction: column;
    gap: 10px;
  }
}
